# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#
# Finnhub API key for the live price updater (update_prices.py / the dashboard's
# Refresh button). Free tier is enough: https://finnhub.io/dashboard
# The key is a ~40-character string. No quotes, no spaces.
FINNHUB_API_KEY=

# You can also supply the key as an environment variable instead of this file:
#   Windows (PowerShell):  $env:FINNHUB_API_KEY = "your_key"
#   macOS/Linux:           export FINNHUB_API_KEY=your_key
